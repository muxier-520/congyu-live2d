# 依赖目录
node_modules/
app/node_modules/

# 环境变量
.env
.env.local
.env.*.local

# 日志文件
*.log
logs/
npm-debug.log*

# 操作系统文件
.DS_Store
Thumbs.db

# IDE 文件
.vscode/
.idea/
*.swp
*.swo

# 临时文件
tmp/
temp/
*.tmp

# Electron 打包输出
dist/
build/
out/

# Electron 二进制文件
*.exe
*.dll
*.pak
*.bin
*.dat
*.json.icd

# 音频文件（太大）
resources/app/audio/*.wav
resources/app/models/sounds/*.wav

# 知识库文件
resources/app/knowledge_base/

# 配置文件（包含敏感信息）
resources/app/config.json

# Reasonix 附件
.reasonix/

# 大型二进制文件
locales/
